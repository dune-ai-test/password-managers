<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme, iOS-style: plain Material-Light framework base (no AppCompat),
         transparent system bars, and the mockup background as window background. -->
    <style name="Theme.Aegis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/aegis_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
